PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/interview-iq?retryWrites=true&w=majority
JWT_SECRET=<generate-a-secure-random-secret-min-32-chars>
JWT_EXPIRES_IN=7d
NODE_ENV=production
CLIENT_URL=https://your-vercel-app.vercel.app

# AI Configuration
# Set to 'gemini' for production, 'mock' for local/testing
AI_PROVIDER=gemini
GEMINI_API_KEY=<your-google-ai-studio-key>
GEMINI_MODEL=gemini-2.0-flash-lite

# Optional Rate Limits (defaults shown)
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_MAX=15
AI_DAILY_REQUEST_LIMIT=50
